# Embeds every file of a directory into the library as a named blob table (src/embedded_data.h: find_blob( name )), through
# the assembler's .incbin (GCC / Clang, including MinGW and clang-cl's driver; MSVC's cl has no .incbin).
#   embed_data( <target> <data dir> )
function( embed_data target data_dir )
	file( GLOB blobs ${data_dir}/* )
	set( out ${CMAKE_CURRENT_BINARY_DIR}/embedded_data_table.cpp )
	set( body "// GENERATED by cmake/embed_data.cmake. Do not edit.\n#include \"embedded_data.h\"\n#include <cstring>\n\n" )
	set( table "" )
	set( n 0 )
	foreach( blob ${blobs} )
		get_filename_component( name ${blob} NAME )
		string( MAKE_C_IDENTIFIER ${name} id )
		string( APPEND body "extern \"C\" const unsigned char p2o_blob_${id}[], p2o_blob_${id}_end[];\n" )
		string( APPEND body "__asm__( \".section .rodata\\n.balign 16\\n.global p2o_blob_${id}\\np2o_blob_${id}:\\n.incbin \\\"${blob}\\\"\\n.global p2o_blob_${id}_end\\np2o_blob_${id}_end:\\n.byte 0\\n.text\\n\" );\n" )
		string( APPEND table "\t{ \"${name}\", p2o_blob_${id}, p2o_blob_${id}_end },\n" )
		set_property( TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${blob} )
		set_property( SOURCE ${out} APPEND PROPERTY OBJECT_DEPENDS ${blob} )
		math( EXPR n "${n} + 1" )
	endforeach()
	string( APPEND body "\nnamespace propan2ol {\n\nnamespace {\nstruct Entry { const char* name; const unsigned char* begin; const unsigned char* end; };\nconst Entry TABLE[] = {\n${table}};\n}\n\n" )
	string( APPEND body "bool find_blob( const char* name, Blob& out ) {\n\tfor ( const Entry& e : TABLE ) {\n\t\tif ( std::strcmp( e.name, name ) == 0 ) { out = { e.begin, static_cast<size_t>( e.end - e.begin ) }; return true; }\n\t}\n\treturn false;\n}\n\n}  // namespace propan2ol\n" )
	file( GENERATE OUTPUT ${out} CONTENT "${body}" )
	target_sources( ${target} PRIVATE ${out} )
endfunction()
